# ==============================================
# 🐼 IQpanda Core System - Configuración
# ==============================================

# --- SERVIDOR ---
# Puerto en el que correrá el servidor backend
PORT=3000

# Ambiente de ejecución: development | production | test
NODE_ENV=development

# --- BASE DE DATOS MONGODB ---
# Conexión a MongoDB
# 
# Para desarrollo local (MongoDB instalado localmente):
#   MONGODB_URI=mongodb://localhost:27017/iqpanda-core
# 
# Para MongoDB Atlas (nube):
#   MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/iqpanda-core
# 
# Para Docker:
#   MONGODB_URI=mongodb://mongodb:27017/iqpanda-core
MONGODB_URI=mongodb://localhost:27017/iqpanda-core

# --- LOGGING ---
# Nivel de detalle de los logs
# Opciones: error | warn | info | debug
# Recomendado: info para desarrollo, warn para producción
LOG_LEVEL=info

# --- SEGURIDAD (Opcional - para implementación futura) ---
# Secreto para firmar tokens JWT (genera uno aleatorio y seguro)
# JWT_SECRET=tu-secreto-super-seguro-de-al-menos-32-caracteres

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo: http://localhost:5173
# En producción: https://tudominio.com
# CORS_ORIGIN=http://localhost:5173

# --- CONFIGURACIÓN DE IA (Opcional - usa valores por defecto si no se especifica) ---
# Los parámetros de IA están en src/config/ai.config.ts
# Puedes sobrescribirlos aquí si necesitas ajustarlos:

# Días de datos históricos para análisis
# AI_HISTORICAL_DAYS_SHORT=7
# AI_HISTORICAL_DAYS_MEDIUM=30
# AI_HISTORICAL_DAYS_LONG=90

# Umbrales de demanda (unidades vendidas en 30 días)
# AI_DEMAND_HIGH=50
# AI_DEMAND_MEDIUM=20

# --- SUPABASE (Observabilidad y Orquestador) ---
# URL del proyecto Supabase
SUPABASE_URL=https://your-project.supabase.co

# Clave anónima (anon key) para acceso público limitado
SUPABASE_ANON_KEY=your-anon-key

# Clave de servicio (service role key) para operaciones administrativas
# ⚠️ NUNCA expongas esta clave en el cliente, solo en el backend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================
# 📝 NOTAS:
# - Copia este archivo a .env y configura tus valores
# - NUNCA subas el archivo .env al repositorio
# - El archivo .env está en .gitignore por seguridad
# ==============================================
